{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["teamId", "repository", "projects"],
  "properties": {
    "$schema": { "type": "string", "enum": ["./projects.schema.json"] },
    "teamId": { "type": "string", "pattern": "^team_" },
    "repository": { "type": "string", "minLength": 3 },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "root", "mode"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "projectId": { "type": "string", "pattern": "^prj_" },
          "root": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["git", "preview-only", "disabled-vercel"] },
          "protectedPreview": { "type": "boolean" },
          "criticalPaths": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
          "expectedText": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
