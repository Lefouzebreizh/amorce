# NexusCrypto — secrets. Copier en `.env` et remplir. Le `.env` réel n'est
# jamais versionné : le `.gitignore` de la racine couvre déjà `.env*`.
#
# Aucun de ces secrets n'est nécessaire pour lancer la simulation. C'est
# volontaire : on doit pouvoir éprouver la stratégie entière, tout un mois de
# données, sans qu'aucune clé n'existe sur la machine.

# --- Plateformes d'échange -------------------------------------------------
# Clés en LECTURE SEULE tant qu'on est en simulation. Les droits de retrait ne
# doivent jamais être accordés à ces clés : un bot n'a aucune raison de
# pouvoir sortir des fonds, et c'est la seule protection qui tienne si la
# machine est compromise.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Hyperliquid signe avec une clé privée de portefeuille. Utiliser une clé
# d'API déléguée (« agent wallet »), jamais celle du portefeuille principal.
HYPERLIQUID_ADRESSE=
HYPERLIQUID_CLE_PRIVEE=

# --- Données ---------------------------------------------------------------
# Facultatives : sans elles, les sources basculent sur leurs points d'entrée
# publics, avec un débit plus faible. Le système le dit au démarrage.
DEXSCREENER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NexusCrypto/1.0 (par u/votre_pseudo)
X_BEARER_TOKEN=

# --- Notifications ---------------------------------------------------------
# Un jeton de bot publié dans un dépôt est un bot volé dans l'heure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
