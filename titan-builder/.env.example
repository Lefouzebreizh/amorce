# Copier en .env.local et remplir ce qu'on a. Ce qui manque ne casse rien :
# le dossier de commande est toujours écrit, c'est l'envoi qui se tait.

# Clé Resend. Sans elle, aucun courriel ne part.
RESEND_API_KEY=

# La boîte qui reçoit les dossiers.
COMMANDE_DESTINATAIRE=erwannchevallier@gmail.com

# L'expéditeur déclaré à Resend. Le domaine partagé marche, mais tombe plus
# souvent en indésirable qu'un domaine vérifié.
COMMANDE_EXPEDITEUR=TITAN BUILDER <onboarding@resend.dev>

# Où atterrissent les dossiers. Sur Vercel, /tmp disparaît avec l'invocation.
DOSSIER_COMMANDES=/tmp/titan-commandes
