# Copier en `.env.local` pour le développement, et reporter ces valeurs dans les
# variables d'environnement du projet Vercel avant la mise en ligne.
#
# Rien n'est obligatoire pour que la page s'affiche : ce qui manque disparaît de
# l'écran au lieu d'afficher une valeur inventée. Mais sans les deux premières,
# le formulaire ne peut rien envoyer.

# Clé d'API Resend (https://resend.com), commence par `re_`.
RESEND_API_KEY=

# La boîte aux lettres qui reçoit les demandes.
DEVIS_DESTINATAIRE=

# Expéditeur des courriels. Laisser vide utilise le domaine partagé de Resend,
# qui fonctionne sans vérification DNS mais tombe plus souvent en indésirable.
# Format : "Nom <adresse@ton-domaine.fr>".
DEVIS_EXPEDITEUR=

# Le numéro affiché et appelable. Vide : les boutons d'appel disparaissent.
NEXT_PUBLIC_TELEPHONE=

# Le numéro WhatsApp au format international, sans espaces (ex. 33612345678).
NEXT_PUBLIC_WHATSAPP=

# Le lien de paiement Stripe à 299 €. Vide : le bouton renvoie au formulaire.
NEXT_PUBLIC_LIEN_STRIPE=

# L'adresse publique du site, pour les métadonnées de partage.
NEXT_PUBLIC_SITE_URL=

# L'adresse de repli du formulaire. La seule variable qui ne demande aucun
# compte à créer : sans clé d'envoi, la demande part de la messagerie de
# l'artisan avec le message déjà écrit. C'est ce qui permet à une première
# vente d'arriver le jour du déploiement.
NEXT_PUBLIC_DEVIS_MAILTO=
