{
  "name": "iptv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestion et lecture de listes IPTV / VOD — cœur d'ingestion et de normalisation",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite next dev",
    "build": "NODE_OPTIONS=--experimental-sqlite next build",
    "start": "NODE_OPTIONS=--experimental-sqlite next start",
    "test": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "check": "tsc --noEmit",
    "iptv": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning src/cli.ts",
    "verify": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning scripts/verifier-interface.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "hls.js": "^1.7.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
