# Gabarit : il documente quels réglages existent, et n'en porte aucun.
# Le fichier `.env` réel est ignoré par Git — les identifiants d'un abonnement
# n'ont rien à faire dans un dépôt.

# Panneau Xtream Codes. L'adresse accepte toutes les formes que les
# fournisseurs envoient : « http://hote:8080 », « hote:8080 », « .../c/ ».
IPTV_XTREAM_SERVEUR=
IPTV_XTREAM_UTILISATEUR=
IPTV_XTREAM_MOT_DE_PASSE=

# Ou une simple liste, en lieu et place du panneau.
IPTV_M3U_URL=

# Guide des programmes. Facultatif : une liste M3U déclare souvent la sienne
# dans son en-tête (`url-tvg`), et un panneau Xtream sert `xmltv.php`.
IPTV_EPG_URL=

# Enrichissement des fiches (affiches, synopsis). Sans clé, l'application
# fonctionne sans affiche plutôt que d'échouer.
TMDB_API_KEY=

# Sous-titres externes, en repli des pistes présentes dans le flux.
OPENSUBTITLES_API_KEY=
SUBDL_API_KEY=
