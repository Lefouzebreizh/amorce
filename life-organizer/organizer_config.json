    },
    {
      "id": "abo-assurance-habitation",
      "nom": "Assurance habitation",
      "categorie": "Assurance",
      "montant": 218.4,
      "periodicite": "annuel",
      "date_souscription": "2022-10-01",
      "date_prochain_prelevement": "2026-10-01",
      "fin_engagement": null,
      "preavis_jours": 60,
      "moyen_paiement": "Prélèvement — compte courant",
      "statut": "actif",
      "url_resiliation": "",
