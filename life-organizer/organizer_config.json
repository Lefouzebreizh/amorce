    }
  ],

  "echeances": [
    {
      "id": "ech-impot-revenu-solde",
      "libelle": "Solde de l'impôt sur le revenu",
      "montant": 0,
      "date_limite": "2026-09-15",
      "recurrence": "annuel",
      "rappels_jours_avant": [30, 7, 1],
      "document_lie": "",
      "statut": "a_payer"
    },
    {
      "id": "ech-taxe-fonciere",
      "libelle": "Taxe foncière",
      "montant": 0,
      "date_limite": "2026-10-15",
      "recurrence": "annuel",
      "rappels_jours_avant": [30, 7, 1],
      "document_lie": "",
      "statut": "a_payer"
    },
    {
      "id": "ech-controle-technique",
      "libelle": "Contrôle technique du véhicule",
      "montant": 0,
      "date_limite": "2027-02-28",
      "recurrence": "biennal",
      "rappels_jours_avant": [60, 15],
      "document_lie": "",
      "statut": "a_planifier"
    }
  ],

  "alertes": {
    "canaux": ["console", "ics"],
    "fichier_ics": "~/Life-Organizer/rappels.ics",
    "heure_du_rappel": "08:30",
    "rappels_jours_avant_defaut": [30, 7, 1],
    "seuil_hausse_abonnement_pct": 10,
    "abonnement_dormant_apres_jours": 90,
    "signaler_doublon_de_service": true
  },

  "resiliation": {
    "fournisseur_ia": "aucun",
    "modele": "",
    "cle_variable_env": "ANTHROPIC_API_KEY",
    "ton": "formel",
    "dossier_sortie": "~/Life-Organizer/Bibliotheque/Documents/Administratif/Résiliations",
    "envoi_automatique": false,
    "expediteur": {
      "nom": "",
      "adresse": "",
      "code_postal": "",
      "ville": "",
      "email": "",
      "telephone": ""
    }
  }
}
