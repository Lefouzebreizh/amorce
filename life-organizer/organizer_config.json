{
  "version": 1,
  "devise": "EUR",

  "dossiers": {
    "entree": [
      "~/Téléchargements",
      "~/Images/À trier",
      "~/Bureau"
    ],
    "bibliotheque": "~/Life-Organizer/Bibliotheque",
    "quarantaine": "~/Life-Organizer/Quarantaine",
    "journal": "~/Life-Organizer/journal",
    "exclusions": [
      "**/node_modules/**",
      "**/.git/**",
      "**/*.app/**",
      "**/Bibliothèque/**"
    ]
  },

  "securite": {
    "simulation_par_defaut": true,
    "suppression_directe": false,
    "retention_quarantaine_jours": 30,
    "confirmer_au_dela_de_mo": 2000,
    "verifier_empreinte_apres_deplacement": true
  },

  "classement": {
    "schema": "{categorie}/{annee}/{mois} - {mois_nom}",
    "categories": {
      "Documents": ["pdf", "docx", "odt", "txt", "rtf", "xlsx", "csv"],
      "Photos": ["jpg", "jpeg", "png", "heic", "heif", "webp", "tiff", "dng", "raw", "cr2", "nef"],
      "Videos": ["mp4", "mov", "mkv", "avi", "wmv", "m4v", "webm"],
      "Audio": ["mp3", "wav", "m4a", "flac", "ogg"],
      "Archives": ["zip", "rar", "7z", "tar", "gz"]
    },
    "source_de_la_date": ["exif", "metadonnees", "nom_de_fichier", "modification"],
    "themes": [
      {
        "nom": "Impôts",
        "dossier": "Documents/Administratif/Impôts",
        "mots_cles": ["avis d'imposition", "direction générale des finances", "revenu fiscal", "taxe foncière", "taxe d'habitation"]
      },
      {
        "nom": "Santé",
        "dossier": "Documents/Administratif/Santé",
        "mots_cles": ["mutuelle", "assurance maladie", "ameli", "décompte de remboursement", "ordonnance"]
      },
      {
        "nom": "Logement",
        "dossier": "Documents/Administratif/Logement",
        "mots_cles": ["quittance de loyer", "bail", "charges de copropriété", "état des lieux", "syndic"]
      },
      {
        "nom": "Banque",
        "dossier": "Documents/Administratif/Banque",
        "mots_cles": ["relevé de compte", "RIB", "échéancier de prêt", "assurance emprunteur"]
      },
      {
        "nom": "Énergie & télécom",
        "dossier": "Documents/Administratif/Énergie et télécom",
        "mots_cles": ["électricité", "gaz", "facture d'eau", "abonnement fibre", "forfait mobile"]
      },
      {
        "nom": "Véhicule",
        "dossier": "Documents/Administratif/Véhicule",
        "mots_cles": ["carte grise", "certificat d'immatriculation", "contrôle technique", "assurance auto"]
      }
    ],
    "sans_date_vers": "À dater",
    "sans_theme_vers": "Divers"
  },

  "scan_ocr": {
    "moteur": "tesseract",
    "langues_ocr": ["fra", "eng"],
    "dpi_rasterisation": 300,
    "pages_max_par_document": 8,
    "confiance_minimale": 0.72,
    "modele_de_nom": "{date}_{emetteur}_{type}{_montant}",
    "extraction": {
      "montants": true,
      "dates": true,
      "numero_de_facture": true,
      "iban": false,
      "numero_de_securite_sociale": false
    },
    "types_reconnus": [
      { "type": "facture",   "mots_cles": ["facture", "montant dû", "TVA", "total TTC"] },
      { "type": "impots",    "mots_cles": ["avis d'impôt", "revenu fiscal de référence", "direction générale des finances publiques"] },
      { "type": "quittance", "mots_cles": ["quittance de loyer", "période du", "acquitté"] },
      { "type": "releve",    "mots_cles": ["relevé de compte", "solde créditeur", "solde débiteur"] },
      { "type": "contrat",   "mots_cles": ["conditions générales", "durée d'engagement", "signature des parties"] },
      { "type": "attestation", "mots_cles": ["atteste que", "attestation de"] }
    ],
    "api_vision": {
      "actif": false,
      "point_de_terminaison": "",
      "cle_variable_env": "LIFE_ORGANIZER_VISION_KEY",
      "envoyer_hors_ligne_seulement_si_echec_local": true
    }
  },

  "nettoyage_medias": {
    "flou": {
      "actif": true,
      "methode": "laplacien",
      "seuil_variance_laplacien": 100.0,
      "seuil_energie_fourier": 12.0,
      "ignorer_si_visage_detecte": true,
      "ignorer_si_recente_jours": 7
    },
    "doublons": {
      "actif": true,
      "hachage": "phash",
      "distance_max": 5,
      "conserver": "meilleure_definition",
      "departager_par": ["nettete", "definition", "poids", "date_la_plus_ancienne"],
      "comparer_entre_dossiers": true
    },
    "videos": {
      "verifier_integrite": true,
      "duree_minimale_secondes": 1.0,
      "taille_minimale_ko": 64,
      "signaler_sans_piste_video": true
    }
  },

  "conversion": {
    "seuil_gain_minimal_pct": 15,
    "conserver_original_jusqua_verification": true,
    "regles": [
      {
        "de": ["heic", "heif"],
        "vers": "jpg",
        "qualite": 88,
        "conserver_exif": true
      },
      {
        "de": ["png"],
        "vers": "jpg",
        "qualite": 90,
        "si_sans_transparence": true
      },
      {
        "de": ["mkv", "avi", "wmv", "m4v"],
        "vers": "mp4",
        "codec_video": "libx264",
        "crf": 21,
        "preset": "slow",
        "codec_audio": "aac",
        "debit_audio": "160k",
        "conserver_metadonnees": true
      }
    ],
    "largeur_max_photo": 4096,
    "hauteur_max_video": 1080
  },

  "upscale": {
    "actif": false,
    "modele": "realesrgan-x4plus",
    "facteur": 2,
    "largeur_source_maximale": 1280,
    "appareil": "cpu",
    "lot_maximal": 25,
    "ecrire_a_cote": true,
    "suffixe": "_hd",
    "api": {
      "actif": false,
      "point_de_terminaison": "",
      "cle_variable_env": "LIFE_ORGANIZER_UPSCALE_KEY"
    }
  },

  "abonnements": [
    {
      "id": "abo-fibre",
      "nom": "Fibre — opérateur",
      "categorie": "Télécom",
      "montant": 39.99,
      "periodicite": "mensuel",
      "date_souscription": "2024-03-12",
      "date_prochain_prelevement": "2026-09-12",
      "fin_engagement": "2025-03-12",
      "preavis_jours": 30,
      "moyen_paiement": "Prélèvement — compte courant",
      "statut": "actif",
      "url_resiliation": "",
      "notes": "Prix passé de 29,99 € à 39,99 € en janvier 2026."
    },
    {
      "id": "abo-streaming",
      "nom": "Streaming vidéo",
      "categorie": "Loisirs",
      "montant": 13.49,
      "periodicite": "mensuel",
      "date_souscription": "2023-11-02",
      "date_prochain_prelevement": "2026-09-02",
      "fin_engagement": null,
      "preavis_jours": 0,
      "moyen_paiement": "Carte bancaire",
      "statut": "a_reexaminer",
