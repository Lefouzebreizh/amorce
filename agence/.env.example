# Projet Supabase — Tableau de bord > Project Settings > API.
# Copier ce fichier en `.env.local` et le remplir. `.env.local` n'est jamais
# versionné : aucune clé ne doit apparaître dans le dépôt.

# URL du projet, visible par le navigateur.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clé publique (anon / publishable). Elle est faite pour être exposée : c'est la
# RLS de PostgreSQL, et elle seule, qui décide ce qu'un porteur de cette clé peut
# lire ou écrire.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Adresse publique du site : elle construit le lien de confirmation d'inscription
# et celui de réinitialisation du mot de passe.
#
# Facultative en développement — sans elle, on retombe sur le port par défaut.
# **Obligatoire en production**, où son absence lève : c'est la seule variable
# dont une valeur fausse laisse le site se construire, se déployer et s'afficher
# normalement, puis casse l'inscription et la récupération de compte, sans qu'une
# seule page change d'aspect.
#
# Sans barre oblique finale et avec le protocole : la liste blanche de
# redirections de Supabase compare au caractère près.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# La clé `service_role` contourne la RLS. Elle n'a rien à faire dans ce socle :
# aucun fichier ne la lit. Si un besoin l'exige un jour (tâche planifiée,
# webhook), elle se déclare ici SANS le préfixe NEXT_PUBLIC_ et ne se lit que
# dans du code serveur.
