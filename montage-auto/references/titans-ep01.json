  "_lisez_moi": [
    "TITANS EP01 — AZNAROTH, montage viral.",
    "",
    "  AFFICHE    0.00 -  0.60",
    "  OEIL       0.60 -  1.80",
    "  MAGE       1.80 -  6.75",
    "  ECLAIRS    6.75 -  8.25",
