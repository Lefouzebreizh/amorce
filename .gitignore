# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rushes de test et captures produits par les scripts de vérification
.fixtures/

# Plan de travail pré-presse KDP (rushes, PDF, épreuves)
.travail/

# Caches Python de la chaîne pré-presse
__pycache__/
*.pyc

# Patrimoine réel de l'assistant d'allocation : ne sort jamais de la machine.
patrimoine/config.json
