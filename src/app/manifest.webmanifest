{
  "name": "Amorce — studio de montage vertical",
  "short_name": "Amorce",
  "description": "Monte tes vidéos IA au format vertical. Tout se passe dans ton navigateur, aucun fichier n'est envoyé sur un serveur.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#07070b",
  "theme_color": "#07070b",
  "lang": "fr",
  "icons": [
    {
      "src": "/icone.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "fichiers",
          "accept": ["audio/*", "video/*", "image/*", ".mp3", ".wav", ".m4a", ".aac", ".ogg", ".flac", ".mp4", ".webm", ".mov", ".png", ".jpg", ".jpeg", ".webp"]
        }
      ]
    }
  }
}
