# Copier ce fichier en `config.env` et le remplir. `config.env` est ignoré par
# git : aucun jeton ne doit entrer dans l'historique.

# --- Facebook ---------------------------------------------------------------
# Jeton d'accès de la Page (pas un jeton utilisateur : il expire en deux heures).
# Permissions attendues : pages_read_engagement et pages_manage_engagement.
FB_ACCESS_TOKEN=
# Identifiant de la Page ou du groupe dont on lit le fil.
FB_GROUP_ID=
# Version de l'API Graph. À relever quand Facebook annonce l'extinction de
# celle-ci — une requête sans numéro se fait servir la plus ancienne encore
# vivante, donc un jour une autre.
FB_API_VERSION=v23.0

# --- Rédaction --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Alerte de fin d'exécution (facultative) --------------------------------
# Sans ALERTE_SMTP_HOTE ou sans ALERTE_DESTINATAIRE, aucun courriel n'est
# envoyé et le script fonctionne normalement.
# Gmail : smtp.gmail.com, port 465, et un « mot de passe d'application »
# (le mot de passe du compte est refusé).
ALERTE_SMTP_HOTE=
ALERTE_SMTP_PORT=465
ALERTE_SMTP_UTILISATEUR=
ALERTE_SMTP_MOTDEPASSE=
ALERTE_DESTINATAIRE=
