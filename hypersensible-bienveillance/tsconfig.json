{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "functions/**/*", "tests/**/*", "*.mjs"],
  "exclude": ["node_modules", "dist", ".wrangler", ".astro"]
}
