---
/**
 * Radar Bien-être : ce que coûtent dix applications de bien-être ce mois-ci.
 *
 * La coquille est servie en HTML statique, les chiffres arrivent ensuite par
 * `/api/radar`. Dix cartes grises apparaissent immédiatement puis se
 * remplissent, plutôt qu'une page blanche pendant l'aller-retour vers D1.
 */
const outils = [
  'Petit BamBou', 'Calm', 'Stoic', 'Headspace', 'Insight Timer',
  'Moodfit', 'Day One', 'Sanvello', 'Bearable', 'Alan Mind',
];
---

<section id="radar" class="scroll-mt-20">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="titre-section">Radar Bien-être</h2>
      <p class="aide mt-2 max-w-2xl">
        Dix applications suivies chaque nuit : le prix affiché, sa variation sur 90 jours, et la
        date du dernier passage. Aucun lien affilié, aucune commission — juste de quoi savoir si
        l’abonnement que tu paies a bougé pendant que tu regardais ailleurs.
      </p>
    </div>
    <p id="radar-etat" class="aide" role="status" aria-live="polite">Relevé en cours…</p>
  </div>

  <p id="radar-simule" hidden class="aide mt-4 rounded-xl border border-alerte/30 bg-alerte/5 px-4 py-3">
    Les liens sont réellement vérifiés chaque nuit ; les variations de prix, elles, sont encore
    simulées le temps que l’analyseur de tarifs soit écrit. Autant le dire plutôt que de te
    laisser croire à un relevé.
  </p>

  <div id="radar-grille" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      outils.map((nom) => (
        <article class="carte p-5 animate-pulse" data-squelette>
          <p class="font-medium">{nom}</p>
          <div class="mt-4 h-8 w-24 rounded bg-bord/60" />
          <div class="mt-4 h-10 rounded bg-bord/40" />
        </article>
      ))
    }
  </div>
</section>

<script>
  interface OutilRadar {
    id: number;
    nom: string;
    url: string;
    prix: number;
    verifie: string;
    variation: number;
    courbe: number[];
  }

  const grille = document.getElementById('radar-grille');
  const etat = document.getElementById('radar-etat');

  const euros = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' });
  const jour = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long' });

  /**
   * Courbe en SVG tracée à la main plutôt qu'avec une bibliothèque : trente
   * lignes ici contre une centaine de kilo-octets à télécharger sur un forfait
   * mobile, pour dessiner une polyligne de trois points.
   */
  function courbeSvg(valeurs: number[], hausse: boolean): string {
    if (valeurs.length < 2) {
      return '<p class="aide">Pas encore assez de relevés pour tracer une courbe.</p>';
    }
    const min = Math.min(...valeurs);
    const max = Math.max(...valeurs);
    // Un prix stable donnerait une division par zéro : on trace alors une ligne
    // médiane, qui est la vérité — le prix n'a pas bougé.
    const amplitude = max - min || 1;
    const pas = 100 / (valeurs.length - 1);
    const points = valeurs
      .map((valeur, index) => {
        const x = (index * pas).toFixed(2);
        const y = (28 - ((valeur - min) / amplitude) * 24).toFixed(2);
        return `${x},${y}`;
      })
      .join(' ');
    const teinte = hausse ? '#F59E0B' : '#06B6D4';
    return `
      <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="h-10 w-full" role="img"
           aria-label="Évolution du prix sur 90 jours">
        <polyline points="${points}" fill="none" stroke="${teinte}" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      </svg>`;
  }

  function carte(outil: OutilRadar): string {
    const hausse = outil.variation > 0;
    const signe = outil.variation > 0 ? '+' : '';
    const couleur = hausse ? 'text-alerte' : outil.variation < 0 ? 'text-cyan' : 'text-estompe';
    const verifie = Number.isNaN(Date.parse(outil.verifie))
      ? 'jamais'
      : `le ${jour.format(new Date(outil.verifie))}`;

    return `
      <article class="carte p-5 flex flex-col gap-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="font-medium">${outil.nom}</h3>
            <p class="aide mt-1">Vérifié ${verifie}</p>
          </div>
          <span class="${couleur} text-sm font-medium tabular-nums">${signe}${outil.variation.toFixed(1)} %</span>
        </div>
        <p class="text-2xl font-semibold tabular-nums">${euros.format(outil.prix)}<span class="aide font-normal"> / mois</span></p>
        ${courbeSvg(outil.courbe, hausse)}
        <a href="${outil.url}" target="_blank" rel="noopener noreferrer nofollow"
           class="aide hover:text-cyan transition">Voir l’offre ↗</a>
      </article>`;
  }

  async function peindre() {
    if (!grille || !etat) return;
    try {
      const reponse = await fetch('/api/radar');
      if (!reponse.ok) throw new Error(String(reponse.status));
      const { outils, simule } = (await reponse.json()) as { outils: OutilRadar[]; simule: boolean };
      grille.innerHTML = outils.map(carte).join('');
      etat.textContent = `${outils.length} applications suivies`;

      // Dit à voix haute ce que la courbe vaut aujourd'hui. Le jour où les prix
      // seront réellement lus, le drapeau tombe et cette ligne disparaît seule.
      const avertissement = document.getElementById('radar-simule');
      if (avertissement) avertissement.hidden = !simule;
    } catch {
      // Message honnête : en développement, `astro dev` ne sert pas les Pages
      // Functions. Le dire évite une demi-heure à chercher une panne qui n'en
      // est pas une.
      etat.textContent = 'Radar indisponible';
      grille.innerHTML = `
        <p class="carte p-5 sm:col-span-2 lg:col-span-3 aide">
          Les prix ne remontent pas pour le moment. En développement, les fonctions Cloudflare
          ne tournent qu’avec <code class="text-cyan">npm run preview</code> — <code class="text-cyan">astro dev</code>
          ne sert que les pages.
        </p>`;
    }
  }

  peindre();
</script>
